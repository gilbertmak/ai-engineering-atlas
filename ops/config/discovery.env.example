# Copy to ~/Library/Application Support/ai-engineer-insight-atlas/discovery.env
# and chmod 600. The YouTube key must stay in the macOS Keychain, never here.
YOUTUBE_DISCOVERY_ENABLED=0
ATLAS_DISCOVERY_SCHEDULE_ENABLED=false
ATLAS_METADATA_AUTO_PUBLISH_ENABLED=false
YOUTUBE_DISCOVERY_CHANNEL_HANDLE=aiDotEngineer
# YOUTUBE_DISCOVERY_UPLOADS_PLAYLIST_ID=
# YOUTUBE_DISCOVERY_CHANNEL_ID=
# YOUTUBE_DISCOVERY_STATE_PATH="$HOME/Library/Application Support/ai-engineer-insight-atlas/state/youtube-discovery-state.json"
# YOUTUBE_DISCOVERY_CANDIDATES_PATH="$HOME/Library/Application Support/ai-engineer-insight-atlas/state/youtube-discovery-candidates.json"
ATLAS_CATALOG_PROJECTION_PATH="$HOME/Library/Application Support/ai-engineer-insight-atlas/projection/atlas-catalog-projection.json"
# Required before metadata-only auto-publication can be enabled. Pin exact values
# after the restricted-key manual full run and content-owner approval.
# ATLAS_APPROVED_YOUTUBE_CHANNEL=AI Engineer
# ATLAS_APPROVED_UPLOADS_PLAYLIST_ID=

# Required only for encrypted backup. This is a public GPG recipient/fingerprint.
# BACKUP_GPG_RECIPIENT=
# BACKUP_DESTINATION="/Volumes/AtlasBackup/ai-engineer-insight-atlas"
